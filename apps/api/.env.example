# Local development — copy to .env if missing
DATABASE_URL=postgresql://appleclub@localhost:5432/ap_pos
PORT=3000

# รหัสในลิงก์ QR สมัครสมาชิก — /member?k=ค่านี้
# MEMBER_KIOSK_KEY=เปลี่ยนเป็นรหัสยาวๆ

# log รับบิลจาก POS (JSON ทีละบรรทัด) — default: apps/api/logs/sync-sales.log
# SYNC_SALES_LOG=/home/pos/AP_POS/apps/api/logs/sync-sales.log

# Discord — ส่งสรุปยอดขายเมื่อมีบิลใหม่ sync
# แนะนำ: ตั้ง webhook ใน Admin → สาขา (คอลัมน์ discord_webhook_url)
# สำรองจาก env (ถ้าว่างในตาราง):
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# DISCORD_WEBHOOK_URL_001=https://discord.com/api/webhooks/...
# DISCORD_WEBHOOK_URL_002=https://discord.com/api/webhooks/...
# ตอน dev ถ้า DB มี webhook จาก production ให้ปิด:
# NOTIFY_DISCORD=0
