{
  "name": "@ap-pos/db",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./sqlite-schema": {
      "types": "./dist/sqlite-schema.d.ts",
      "require": "./dist/sqlite-schema.js",
      "import": "./dist/sqlite-schema.js",
      "default": "./dist/sqlite-schema.js"
    },
    "./pg-schema": {
      "types": "./dist/pg-schema.d.ts",
      "require": "./dist/pg-schema.js",
      "import": "./dist/pg-schema.js",
      "default": "./dist/pg-schema.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:push:pg": "drizzle-kit push --config=drizzle.pg.config.ts",
    "db:studio:pg": "drizzle-kit studio --config=drizzle.pg.config.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.38.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/pg": "^8.20.0",
    "better-sqlite3": "^13.0.1",
    "drizzle-kit": "^0.30.2",
    "pg": "^8.22.0",
    "typescript": "^5.7.3"
  }
}
